{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyWalletDsBundle.components.credential-check.credential-check::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/marker') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/date-display') -}}
{%- endblock -%}

{#- The outcome, when it was, and why when refused, as a record's details
    are said: the design system's list of properties. What tests it again is
    the page's own action, in its toolbar (`[data-credential-check]`). -#}
{%- block vue_body -%}
    <section class="block block--padded">
        <dl class="properties">
            <div class="properties--row">
                <dt class="properties--key">[[ t('field.status') ]]</dt>
                <dd class="properties--value"><ds-marker :tone="tone" :label="t('status.' + (outcome.status || 'never'))" compact></ds-marker></dd>
            </div>
            <div v-if="outcome.checkedAt && outcome.status !== 'pending'" class="properties--row">
                <dt class="properties--key">[[ t('field.checked_at') ]]</dt>
                <dd class="properties--value"><date-display :value="outcome.checkedAt" format="date_time"></date-display></dd>
            </div>
            <div v-if="outcome.message && outcome.status !== 'pending'" class="properties--row properties--row--full">
                <dt class="properties--key">[[ t('field.message') ]]</dt>
                <dd class="properties--value"><code class="credential-check--message">[[ outcome.message ]]</code></dd>
            </div>
        </dl>
    </section>
{%- endblock -%}
