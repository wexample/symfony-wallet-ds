{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{#- What names the credential, then what its kind asks to connect. -#}
{% block form_body %}
    <fieldset>
        <legend>{{ '@form::group.general' | trans }}</legend>
        {{ form_row(form.title) }}
    </fieldset>
    <fieldset class="form--columns form--columns-2">
        <legend>{{ '@form::group.connection' | trans }}</legend>
        {%- for field in form|filter(field => field.vars.name starts with 'parameter_') -%}
            {{ form_row(field) }}
        {%- endfor -%}
    </fieldset>
    {{ form_actions(form) }}
{% endblock %}
