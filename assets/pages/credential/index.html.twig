{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{%- set page_body_mode = 'wide' -%}

{#- A credential is added by its type: each asks its own parameters. -#}
{%- block page_toolbar_right -%}
    {{ button_menu('ph:bold/plus', '@page::action.create' | trans, credential_types | map(type => {
        label: type.label,
        icon: type.icon,
        href: path('credential_create', { type: type.value }),
        target: 'panel'
    }), { class: 'button', caret: true }) }}
{%- endblock -%}

{#- The credentials, read from the api: searched, filtered, sorted and paged
    by the table. What the rows' actions did is said in toasts, from the
    flashes; a test's outcome, on its row once it is answered. -#}
{%- block page_body -%}
    {{ vue(render_pass, '@WexampleSymfonyWalletDsBundle/components/credential-table', { types: credential_types }) }}
{%- endblock -%}
