{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- A record's page: the header says what kind of thing it is, the page
    names the one opened, the bar under the header leads back to the list. -#}
{%- set page_show_title = true -%}
{%- set header_title = '@page::type' | trans -%}
{%- set page_title = credential.title -%}
{%- set page_trail = 'back' -%}

{%- block header_title_aside -%}
    {{ marker('neutral', type_title, { compact: true }) }}
{%- endblock -%}

{#- Its connection tested again, from the page's toolbar — over the page, or
    under a panel's header when the page is read in one. -#}
{%- block page_title_actions -%}
    {{ button('ph:bold/plugs-connected', 'WexampleSymfonyWalletDsBundle.components.credential-check.credential-check::test' | trans, { 'data-credential-check': credential.id ~ '' }) }}
{%- endblock -%}

{%- block page_body -%}
    {#- Its connection's last test. -#}
    {{ vue(render_pass, '@WexampleSymfonyWalletDsBundle/components/credential-check', {
        credentialId: credential.id ~ '',
        status: credential.checkStatus,
        message: credential.checkMessage,
        checkedAt: credential.checkedAt ? credential.checkedAt | date('c') : null
    }) }}
    {{ include('@WexampleSymfonyPlatformDsBundle/partials/form_card.html.twig', { form: form_edit, template: '@WexampleSymfonyWalletDsBundle/forms/credential_form.html.twig' }) }}
{%- endblock -%}
